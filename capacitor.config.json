{
  "appId": "mg.tendry.epicerie",
  "appName": "Tendry Epicerie",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#4f46e5",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
